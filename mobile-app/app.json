{
  "expo": {
    "name": "Dumela Stays",
    "slug": "dumela-stays",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "package": "com.dumela.stays",
      "adaptiveIcon": {
        "backgroundColor": "#14352A",
        "foregroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14352A",
          "image": "./assets/images/logo.png",
          "imageWidth": 150
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "51043a97-2c4c-4155-91b0-c7a5d575a3fb"
      }
    },
    "owner": "dumela-stays-team"
  }
}
